# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# Modelo do Ollama usado pelos dois agentes: o de análise (organiza o que o aluno digitou e
# prepara a palavra em inglês) e o de chat (tradução e pronúncia, chama as tools).
# Precisa ter suporte a tool calling. Para algo mais leve, use llama3.2 (3B).
OLLAMA_MODEL=llama3.1

# Modelo de embeddings do RAG (Hugging Face, roda localmente em ONNX)
HF_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Token do Hugging Face (opcional, só aumenta o limite de downloads). Para usar, remova o "#".
# HF_TOKEN=

# Chave de API do Ollama Cloud (opcional). Para usar, remova o "#" da linha abaixo.
# OLLAMA_API_KEY=85d6a83d5de941feb0b8f9bd46c533c6.1_JZAZ-cJzEZxp21VSrxg9iV
